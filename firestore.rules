rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function prof() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && prof().active == true; }
    function owner() { return active() && prof().role == 'owner'; }

    match /users/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || owner());
      allow create: if owner() || (request.auth != null && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['username','role','active'])
        && request.resource.data.role == 'staff'
        && request.resource.data.active == false);
      allow update, delete: if owner();
    }
    match /ads/{id} {
      allow read, write: if active();
    }
    match /settings/{id} {
      allow read: if active();
      allow write: if owner();
    }
  }
}

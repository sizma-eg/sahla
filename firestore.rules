rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function staff() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isOwner() { return staff() && me().role == 'owner'; }
    match /users/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || isOwner());
      allow write: if isOwner();
    }
    match /ads/{id} { allow read, write: if staff(); }
    match /settings/{id} { allow read: if staff(); allow write: if isOwner(); }
  }
}
